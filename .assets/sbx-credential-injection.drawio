<mxfile host="app.diagrams.net" type="device">
  <diagram id="sbx-cred-injection" name="credential injection">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="agent" value="AI agent (in sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="Host Proxy&#10;(MITM CA + policy + injection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#e65100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="keychain" value="Host keychain&#10;real OPENAI_API_KEY" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe0b2;strokeColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="440" y="250" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="openai" value="api.openai.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfd8dc;strokeColor=#546e7a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1. HTTPS request&#10;Authorization: Bearer proxy-managed&#10;(sentinel / placeholder)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="agent" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. look up real secret&#10;(never leaves the host)" style="endArrow=block;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="keychain" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. same request, sentinel&#10;swapped for the real key" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="proxy" target="openai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. response" style="endArrow=block;html=1;dashed=1;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="openai" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="The real credential NEVER enters the sandbox.&#10;The agent (and anything it runs) only ever sees the &quot;proxy-managed&quot; sentinel.&#10;Injection happens only for the destination domain declared for that service." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="920" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
